# Operio Backend Configuration
APP_NAME=Operio Modular Operations Suite
SECRET_KEY=yoursecretkeyhere_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For production, use PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./operio.db

# CORS
# In production, specify your frontend domain: ["https://app.operio.dev"]
CORS_ORIGINS=["*"]

# File Storage
UPLOAD_DIR=storage/uploads

# Email Settings
EMAIL_PROVIDER=resend # resend or smtp

# SMTP Settings
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@operio.dev
SMTP_FROM_NAME=Operio
SMTP_USE_TLS=true

# Resend API Settings
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@operio.dev
RESEND_FROM_NAME=Operio

ADMIN_NOTIFICATION_EMAIL=admin@operio.dev

