# Operio Environment Configuration Example

# --- Backend Configuration ---
APP_NAME=Operio
APP_ENV=development
SECRET_KEY=generate_a_secure_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# SQLite (Development)
DATABASE_URL=sqlite:///./operio_demo.db
# PostgreSQL (Production)
# DATABASE_URL=postgresql+psycopg2://operio_user:strong_password@db.render.com:5432/operio_db

# Production Environment
# APP_ENV=production

# Production Bootstrap (Super Admin)
# OPERIO_SUPERADMIN_EMAIL=superadmin@operio.dev
# OPERIO_SUPERADMIN_PASSWORD=change-this-password
# OPERIO_SUPERADMIN_NAME=Fikir Super Admin

# File Storage
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=10

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://operio.fikircreative.com

# --- Frontend Configuration ---
VITE_APP_TITLE=Operio Modular Operations Suite
VITE_API_URL=http://localhost:8000/api
